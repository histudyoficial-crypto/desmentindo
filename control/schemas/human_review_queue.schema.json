{
  "$id": "human_review_queue.schema.json",
  "type": "object",
  "required": ["schema", "updated_at", "items"],
  "properties": {
    "schema": {"const": "desmentindo.control.human_review_queue.v1"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp_required"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["review_id", "story_id", "title", "review_reason", "claim_summary", "evidence_summary", "counter_evidence_summary", "sources", "rhr_context", "flags", "created_at", "status", "decision"],
        "properties": {
          "review_id": {"type": "string", "pattern": "^RV-\\d{8}-\\d{3}$"},
          "story_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "review_reason": {"enum": ["SUBSTANTIVE_POLITICAL_CONCLUSION", "NEW_ALLEGATION", "CONTRADICTION_CLAIM", "IMAGE_RIGHTS", "LEGAL_RISK", "LOW_CONFIDENCE", "CORRECTION", "OTHER"]},
          "claim_summary": {"type": "string", "minLength": 1},
          "evidence_summary": {"type": "string"},
          "counter_evidence_summary": {"type": "string"},
          "sources": {
            "type": "array",
            "items": {"type": "object", "required": ["title", "url"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://"}}}
          },
          "rhr_context": {
            "type": "object",
            "required": ["rhr_warranted", "rhr_executed", "result"],
            "properties": {
              "rhr_warranted": {"type": ["boolean", "null"]},
              "rhr_executed": {"type": "boolean"},
              "result": {"enum": ["OCCURRENCES_FOUND", "NO_MATCH", "QUERY_UNAVAILABLE", "NOT_EXECUTED", "NOT_WARRANTED"]},
              "sources_queried": {"type": "array", "items": {"type": "string"}},
              "summary": {"type": ["string", "null"]}
            }
          },
          "flags": {"type": "array", "items": {"enum": ["HYPOTHESIS_NOT_FACT", "ALLEGATION_NOT_PROOF", "TEMPORAL_CHANGE_NOT_CONTRADICTION", "LINK_NOT_INFLUENCE", "INFLUENCE_NOT_COORDINATION", "COORDINATION_NOT_ILLEGALITY", "SINGLE_SOURCE", "PARTIAL_CORPUS", "IMAGE_RIGHTS_UNCLEAR", "LEGAL_REVIEW", "FUTURE_TIMESTAMP"]}},
          "created_at": {"$ref": "common.schema.json#/$defs/timestamp_required"},
          "status": {"enum": ["WAITING_REVIEW", "APPROVED", "CHANGES_REQUESTED", "HOLD", "REJECTED"]},
          "decision": {
            "type": ["object", "null"],
            "required": ["decided_by", "decided_at", "decision_ref"],
            "properties": {
              "decided_by": {"type": "string", "minLength": 1},
              "decided_at": {"$ref": "common.schema.json#/$defs/timestamp_required"},
              "decision_ref": {"type": "string", "pattern": "^https://github\\.com/"},
              "notes": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
