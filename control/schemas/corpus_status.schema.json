{
  "$id": "corpus_status.schema.json",
  "type": "object",
  "required": ["schema", "updated_at", "sources"],
  "properties": {
    "schema": {"const": "desmentindo.control.corpus_status.v1"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp_required"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "display_name", "source_type", "corpus_membership", "technical_searchability", "adapter_health", "coverage", "freshness", "rhr"],
        "properties": {
          "corpus_membership": {"enum": ["MEMBER", "CANDIDATE", "NOT_MEMBER"]},
          "technical_searchability": {"enum": ["SEARCHABLE", "NOT_SEARCHABLE", "NOT_CONFIGURED", "UNKNOWN"]},
          "adapter_health": {"$ref": "common.schema.json#/$defs/health_state"},
          "rhr": {
            "type": "object",
            "required": ["rhr_warranted", "rhr_executed", "occurrences_found", "no_match", "query_unavailable"],
            "additionalProperties": {"$ref": "common.schema.json#/$defs/metric"}
          }
        }
      }
    }
  }
}
