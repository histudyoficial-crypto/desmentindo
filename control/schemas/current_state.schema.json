{
  "$id": "current_state.schema.json",
  "type": "object",
  "required": ["schema", "updated_at", "updated_by", "timezone", "operational_date", "last_run", "next_run", "routines", "publish_state", "human_gate_state", "open_stories", "pending_human_reviews", "active_incidents", "degraded_services", "last_operational_commit", "last_successful_run", "lock", "overall_status"],
  "properties": {
    "schema": {"const": "desmentindo.control.current_state.v1"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp_required"},
    "timezone": {"const": "America/Sao_Paulo"},
    "operational_date": {"$ref": "common.schema.json#/$defs/date"},
    "last_run": {
      "type": ["object", "null"],
      "required": ["routine", "run_id", "started_at", "finished_at", "status"],
      "properties": {
        "routine": {"$ref": "common.schema.json#/$defs/routine_name"},
        "run_id": {"type": "string"},
        "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "finished_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "status": {"$ref": "common.schema.json#/$defs/routine_status"}
      }
    },
    "next_run": {
      "type": "object",
      "required": ["routine", "scheduled_for", "mode"],
      "properties": {
        "routine": {"$ref": "common.schema.json#/$defs/routine_name"},
        "scheduled_for": {"$ref": "common.schema.json#/$defs/timestamp"},
        "mode": {"enum": ["MANUAL", "SCHEDULED"]}
      }
    },
    "routines": {
      "type": "object",
      "required": ["MORNING_OPEN", "AFTERNOON_UPDATE", "EVENING_CLOSE"],
      "additionalProperties": {
        "type": "object",
        "required": ["status", "last_run_id", "started_at", "finished_at"],
        "properties": {
          "status": {"$ref": "common.schema.json#/$defs/routine_status"},
          "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
          "finished_at": {"$ref": "common.schema.json#/$defs/timestamp"}
        }
      }
    },
    "publish_state": {"enum": ["OFF", "ON"]},
    "human_gate_state": {"enum": ["REQUIRED", "WAIVED_FOR_TECHNICAL_ONLY"]},
    "open_stories": {"$ref": "common.schema.json#/$defs/metric"},
    "pending_human_reviews": {"$ref": "common.schema.json#/$defs/metric"},
    "active_incidents": {"$ref": "common.schema.json#/$defs/metric"},
    "degraded_services": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/component"}},
    "overall_status": {"$ref": "common.schema.json#/$defs/health_state"},
    "last_operational_commit": {"type": ["string", "null"]},
    "last_successful_run": {"type": ["object", "null"]},
    "lock": {
      "type": "object",
      "required": ["held", "routine", "holder", "run_id", "acquired_at", "expires_at"],
      "properties": {
        "held": {"type": "boolean"},
        "acquired_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    }
  }
}
