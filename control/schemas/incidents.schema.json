{
  "$id": "incidents.schema.json",
  "type": "object",
  "required": ["schema", "updated_at", "items"],
  "properties": {
    "schema": {"const": "desmentindo.control.incidents.v1"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp_required"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["incident_id", "timestamp", "component", "type", "severity", "description", "impact", "status", "resolution"],
        "properties": {
          "incident_id": {"type": "string", "pattern": "^INC-\\d{8}-\\d{3}$"},
          "timestamp": {"$ref": "common.schema.json#/$defs/timestamp_required"},
          "component": {"$ref": "common.schema.json#/$defs/component"},
          "type": {"enum": ["CONCURRENCY_COLLISION", "CAPACITY_DEGRADATION", "SOURCE_UNAVAILABLE", "FUTURE_TIMESTAMP_ANOMALY", "RHR_UNAVAILABLE", "PUBLISHER_FAILURE", "SCHEMA_FAILURE", "DEPLOY_FAILURE", "OTHER"]},
          "severity": {"enum": ["SEV1", "SEV2", "SEV3", "SEV4"]},
          "description": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "status": {"enum": ["OPEN", "MITIGATED", "RESOLVED"]},
          "resolution": {"type": ["string", "null"]},
          "resolved_at": {"$ref": "common.schema.json#/$defs/timestamp"}
        }
      }
    }
  }
}
