{
  "schema": "desmentindo.ops.config.v1",
  "timezone": "America/Sao_Paulo",
  "publish": "OFF",
  "human_gate": "REQUIRED",
  "schedules_enabled": false,
  "schedules_note": "Nenhuma rotina tem schedule ativo. Ativar somente depois do ciclo manual MORNING -> AFTERNOON -> EVENING revisado por Johnny.",
  "repo_visibility": "PUBLIC",
  "repo_visibility_note": "O repositório é público: tudo em control/, reports/ e command-center/ é legível por qualquer pessoa. Até decisão (ver DECISION_QUEUE DQ-0001), a fila de Human Review guarda somente resumos e links, nunca rascunhos integrais nem conclusões pré-publicação.",
  "routines": {
    "MORNING_OPEN": {
      "order": 1,
      "window_local": "07:00",
      "window_state": "PROPOSED",
      "runbook": "operations/runbooks/MORNING_OPEN.md",
      "prompt": "operations/prompts/MORNING_OPEN.md",
      "concurrency_group": "desmentindo-ops",
      "context_budget": {
        "always": ["CLAUDE.md", "control/CURRENT_STATE.json", "control/HEALTH.json", "control/HUMAN_REVIEW_QUEUE.json", "control/INCIDENTS.json"],
        "on_demand": ["control/CORPUS_STATUS.json", "control/PIPELINE_TODAY.json"],
        "never_by_default": ["data/ag/*", "data/corpus/links.*", "index.html", "desmentindo_local.html"]
      }
    },
    "AFTERNOON_UPDATE": {
      "order": 2,
      "window_local": "14:00",
      "window_state": "PROPOSED",
      "runbook": "operations/runbooks/AFTERNOON_UPDATE.md",
      "prompt": "operations/prompts/AFTERNOON_UPDATE.md",
      "concurrency_group": "desmentindo-ops",
      "context_budget": {
        "always": ["CLAUDE.md", "control/CURRENT_STATE.json", "control/PIPELINE_TODAY.json", "control/HUMAN_REVIEW_QUEUE.json"],
        "on_demand": ["control/HEALTH.json", "control/CORPUS_STATUS.json", "control/INCIDENTS.json"],
        "never_by_default": ["data/ag/*", "data/corpus/links.*", "index.html", "desmentindo_local.html"]
      }
    },
    "EVENING_CLOSE": {
      "order": 3,
      "window_local": "21:00",
      "window_state": "PROPOSED",
      "runbook": "operations/runbooks/EVENING_CLOSE.md",
      "prompt": "operations/prompts/EVENING_CLOSE.md",
      "concurrency_group": "desmentindo-ops",
      "context_budget": {
        "always": ["CLAUDE.md", "control/CURRENT_STATE.json", "control/HEALTH.json", "control/PIPELINE_TODAY.json", "control/HUMAN_REVIEW_QUEUE.json", "control/INCIDENTS.json"],
        "on_demand": ["control/RESULTS.json", "control/VIDEO_ENGINE.json"],
        "never_by_default": ["data/ag/*", "data/corpus/links.*", "index.html", "desmentindo_local.html"]
      }
    }
  },
  "lock": {
    "default_ttl_minutes": 90,
    "location": "control/CURRENT_STATE.json#lock"
  },
  "rhr_policy": "Executar RHR somente quando RHR_WARRANTED=true para a história. Nunca registrar NO_MATCH sem execução real de consulta.",
  "github": {
    "repository": "histudyoficial-crypto/desmentindo",
    "decision_channel": "issues",
    "decision_issue_label": "human-gate"
  }
}
